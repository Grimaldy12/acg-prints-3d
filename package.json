{
  "name": "print-flow-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Sales management system for 3D printing business",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.11.0"
  }
}
